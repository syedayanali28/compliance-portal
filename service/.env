# Copy this file to .env in this same folder (service/.env). Loaded automatically from service/.env.

# JIRA
JIRA_BASE_URL=https://jira.intra.hkma.gov.hk
JIRA_SERVICE_ACCOUNT_TOKEN=yOTgwNDM2MzI5NDEzOmEdcpZ2SoKVMVdCsoI7tQfF0plF
# Atlassian Cloud style: set email and use API token as JIRA_SERVICE_ACCOUNT_TOKEN
# JIRA_USER_EMAIL=you@example.com
# Dev TLS to internal Jira: JIRA_TLS_INSECURE=true
JIRA_WEBHOOK_SECRET=your-webhook-secret
JIRA_FIREWALL_PROJECT_KEY=ITISUFR


LLM_PROVIDER=maas
LLM_API_KEY=7RYkUPHtZzZuB6bS8qok8apbBvHVtE
LLM_ENDPOINT=https://maas-trial-qwen3-30b.model-serving-farm.intra.hkma.gov.hk/v1
LLM_MODEL=qwen3-30b-instruct-awq-maas-trial-endpoint

# ACCESS KEY ID is tracked separately for operations, while requests use MAAS_API_KEY as Bearer token.
MAAS_ACCESS_KEY_ID=hrms-summarize-model
MAAS_API_KEY=7RYkUPHtZzZuB6bS8qok8apbBvHVtE
MAAS_URL=https://maas-trial-qwen3-30b.model-serving-farm.intra.hkma.gov.hk
MAAS_MODEL=qwen3-30b-instruct-awq-maas-trial-endpoint

# Cron expression for the automatic poller (default: 8am daily)
POLL_CRON=0 8 * * *

# Set to true to post analysis comments back to JIRA issues
POST_JIRA_COMMENTS=false

# Dev only: internal TLS (self-signed). Prefer npm run start:system-ca when possible.
JIRA_TLS_INSECURE=true
LLM_TLS_INSECURE=true

# Port the Express server listens on
SERVICE_PORT=3001

