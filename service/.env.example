# ─────────────────────────────────────────────────────────────
# HKMA Firewall Analysis Service — environment variables
# Copy this file to .env and fill in real values on target device.
# Leaving JIRA_URL or LLM_URL blank enables stub/demo mode.
# ─────────────────────────────────────────────────────────────

# ── JIRA (leave blank for stub mode) ─────────────────────────
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=
JIRA_FIREWALL_PROJECT_KEY=FWREQ

# ── LLM (leave blank for stub mode) ──────────────────────────
LLM_URL=
LLM_API_KEY=

# ── Behaviour ─────────────────────────────────────────────────
# Cron expression for the automatic poller (default: 8am daily)
POLL_CRON=0 8 * * *

# Set to true to post analysis comments back to JIRA issues
POST_JIRA_COMMENTS=false

# Port the Express server listens on
SERVICE_PORT=3001
