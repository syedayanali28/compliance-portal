# Copy this file to .env in this same folder (service/.env). Loaded automatically from service/.env.
# Optional: .env.local in this folder overrides .env (for local secrets; do not commit .env.local).

# JIRA_BASE_URL or JIRA_URL
JIRA_BASE_URL=https://jira.intra.hkma.gov.hk
JIRA_SERVICE_ACCOUNT_TOKEN=your-token-or-pat
# Cloud API token: set your Atlassian account email
# JIRA_USER_EMAIL=you@example.com
# Dev only if Node rejects internal TLS: JIRA_TLS_INSECURE=true
JIRA_WEBHOOK_SECRET=your-webhook-secret
JIRA_FIREWALL_PROJECT_KEY=ITISUFR

LLM_PROVIDER=maas
# Prefer MAAS_API_KEY; config uses MAAS_API_KEY before LLM_API_KEY when both are set
LLM_ENDPOINT=https://your-maas-host/v1
LLM_MODEL=your-model-id
LLM_API_KEY=

MAAS_ACCESS_KEY_ID=
MAAS_API_KEY=your-bearer-token
MAAS_URL=https://your-maas-host
MAAS_MODEL=your-model-id

# --- TLS to internal MaaS (Windows / corporate CA) ---
# If Node errors: "unable to verify the first certificate" / UNABLE_TO_VERIFY_LEAF_SIGNATURE:
# Option A (preferred): npm run start:system-ca   (Node 22+ uses OS trust store on Windows)
# Option B: export your org root PEM and set NODE_EXTRA_CA_CERTS=C:\path\to\corp-root.pem
# Option C (dev only): LLM_TLS_INSECURE=true  (disables TLS verification for this whole process)

# Cron expression for the automatic poller (default: 8am daily)
POLL_CRON=0 8 * * *

# Set to true to post analysis comments back to JIRA issues
POST_JIRA_COMMENTS=false

# Port the Express server listens on
SERVICE_PORT=3001

