{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/js/bootstrap.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/src/main/webapp/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/src/main/webapp/$1"
    }
  ]
}
