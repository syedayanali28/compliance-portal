  "firewallRules": {
    "default": { "required": true, "firewallType": "physical", "provider": "NSX" },
    "rules": [
      {
        "id": "fw-same-parent-no-op",
        "priority": 1000,
        "enabled": true,
        "when": { "sameParent": true },
        "effect": {
          "required": false,
          "firewallType": "virtual",
          "provider": "NSX",
          "reason": "Intra-host / same parent container; no firewall required."
        }
      },
      {
        "id": "fw-cross-zone-default",
        "priority": 900,
        "enabled": true,
        "when": { "sameZone": false },
        "effect": {
          "required": true,
          "firewallType": "physical",
          "provider": "NSX",
          "reason": "Cross-zone traffic requires physical NSX firewall."
        }
      },
      {
        "id": "fw-oa-private-cloud-same-zone",
        "priority": 500,
        "enabled": true,
        "when": { "sameZone": true, "zoneId": ["oa-private-cloud"] },
        "effect": {
          "required": true,
          "firewallType": "virtual",
          "provider": "PSO",
          "reason": "Intra oa-private-cloud uses PSO micro-segmentation."
        }
      },
      {
        "id": "fw-aws-landing-zone-same-zone",
        "priority": 500,
        "enabled": true,
        "when": { "sameZone": true, "zoneId": ["aws-landing-zone"] },
        "effect": {
          "required": true,
          "firewallType": "virtual",
          "provider": "AWS",
          "reason": "Intra AWS landing zone uses AWS SG/NACL."
        }
      },
      {
        "id": "fw-oa-baremetal-same-zone",
        "priority": 400,
        "enabled": true,
        "when": { "sameZone": true, "zoneId": ["oa-baremetal", "oa-app-dmz", "dmz"] },
        "effect": {
          "required": true,
          "firewallType": "physical",
          "provider": "NSX",
          "reason": "Intra baremetal/DMZ uses physical NSX."
        }
      },
      {
        "id": "fw-idmz-same-zone",
        "priority": 400,
        "enabled": true,
        "when": { "sameZone": true, "zoneId": ["idmz"] },
        "effect": {
          "required": true,
          "firewallType": "physical",
          "provider": "NSX",
          "reason": "Intra IDMZ uses physical NSX."
        }
      },
      {
        "id": "fw-k8s-same-zone",
        "priority": 400,
        "enabled": true,
        "when": { "sameZone": true, "zoneId": ["k8s-cluster", "k8s-namespace", "messaging-infrastructure"] },
        "effect": {
          "required": true,
          "firewallType": "virtual",
          "provider": "NSX",
          "reason": "Intra Kubernetes cluster/namespace uses virtual NSX micro-segmentation."
        }
      },
      {
        "id": "fw-data-platform-same-zone",
        "priority": 400,
        "enabled": true,
        "when": { "sameZone": true, "zoneId": ["data-platform"] },
        "effect": {
          "required": true,
          "firewallType": "physical",
          "provider": "NSX",
          "reason": "Intra Data Platform zone uses physical NSX."
        }
      }
    ]
  },
  "rules": {
    "edgeRules": [
      {
        "id": "deny-external-to-database-direct",
        "enabled": true,
        "effect": "deny",
        "priority": 100,
        "severity": "error",
        "when": {
          "fromCategory": ["external"],
          "toCategory": ["database"]
        },
